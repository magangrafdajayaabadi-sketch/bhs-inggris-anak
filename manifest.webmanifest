{
  "id": "/",
  "name": "Bhs Inggris",
  "short_name": "Bhs Inggris",
  "description": "Bermain sambil belajar Bahasa Inggris untuk anak usia 6-12 tahun.",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
